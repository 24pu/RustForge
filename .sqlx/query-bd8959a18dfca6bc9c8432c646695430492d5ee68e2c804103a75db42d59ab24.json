  "query": "SELECT pc.id, pc.name, pc.slug, pc.description, pc.parent_id, pc.sort, pc.show_in_nav, pc.created_at, pc.updated_at\n            FROM product_categories pc\n            INNER JOIN product_category_relations pcr ON pc.id = pcr.category_id\n            WHERE pcr.product_id = $1\n            ORDER BY pc.sort",

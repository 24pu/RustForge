  "db_name": "PostgreSQL",
  "query": "SELECT id, slug, title, body, published, cover_image, lang, translation_group, created_at, updated_at\n           FROM contents\n           WHERE published = true AND lang = $1 AND (title ILIKE $2 OR body ILIKE $2 OR slug ILIKE $2)\n           ORDER BY created_at DESC\n           LIMIT $3 OFFSET $4",

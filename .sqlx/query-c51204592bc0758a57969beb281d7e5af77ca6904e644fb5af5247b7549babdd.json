{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    oi.*,\n                    p.cover_image as product_cover_image,\n                    pv.color as variant_color,\n                    pv.size as variant_size\n                FROM order_items oi\n                LEFT JOIN products p ON p.id = oi.product_id\n                LEFT JOIN product_variants pv ON pv.id = oi.variant_id\n                WHERE oi.order_id = $1\n                ",
